local Lighting = game:GetService("Lighting")

--// SKYBOX
local skyData = {
    SkyboxBk = "rbxassetid://7658055825",
    SkyboxDn = "rbxassetid://7658055825",
    SkyboxFt = "rbxassetid://7658055825",
    SkyboxLf = "rbxassetid://7658055825",
    SkyboxRt = "rbxassetid://7658055825",
    SkyboxUp = "rbxassetid://7658055825"
}

--// MAP TEXTURE REPLACEMENT
--// 7658055825 -> 80535537978765

local OLD_ID = "7658055825"
local NEW_ID = "80535537978765"

local function isOldTexture(textureId)
    if not textureId then
        return false
    end

    return string.find(textureId, OLD_ID, 1, true) ~= nil
end

for _, object in ipairs(workspace:GetDescendants()) do

    -- Textures
    if object:IsA("Texture") then
        if isOldTexture(object.Texture) then
            object.Texture = "rbxassetid://" .. NEW_ID
        end

    -- Decals
    elseif object:IsA("Decal") then
        if isOldTexture(object.Texture) then
            object.Texture = "rbxassetid://" .. NEW_ID
        end

    -- SurfaceAppearance
    elseif object:IsA("SurfaceAppearance") then
        if isOldTexture(object.ColorMap) then
            object.ColorMap = "rbxassetid://" .. NEW_ID
        end
    end
end

print("Texture replacement complete: " .. OLD_ID .. " -> " .. NEW_ID)

--// APPLY SKYBOX
local function applySkybox()
    local sky = Lighting:FindFirstChildOfClass("Sky")

    if not sky then
        sky = Instance.new("Sky")
        sky.Parent = Lighting
    end

    for property, value in pairs(skyData) do
        sky[property] = value
    end
end

applySkybox()

--// KEEP SKYBOX ACTIVE
Lighting.ChildRemoved:Connect(function(child)
    if child:IsA("Sky") then
        task.wait()
        applySkybox()
    end
end)

Lighting.ChildAdded:Connect(function(child)
    if child:IsA("Sky") then
        task.wait()
        applySkybox()
    end
end)
